Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 65
  Property Tree Widget:
    Expanded: []
    Tree Height: 460
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_common/Group
    Name: Ground and vehicle | FlatAsphalt map z=0
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Grid
      Name: Map grid | fixed world (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 120
      Color: 120; 145; 170
      Alpha: 0.7
      Reference Frame: map
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: -0.02
    - Class: rviz_default_plugins/RobotModel
      Name: FSAI | map-ground aligned preview
      Enabled: true
      Description Source: File
      Description File: /home/hassan/ASURT/Simulation/Systems/SLAM/Visualization/fsai_vehicle_map_ground_preview.urdf
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
      TF Prefix: ''
    - Class: rviz_default_plugins/Grid
      Name: Car-centred grid | 1 m (requires map-to-base_link TF)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 36
      Color: 75; 175; 195
      Alpha: 0.65
      Reference Frame: base_link
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: 0.01
  - Class: rviz_common/Group
    Name: SLAM cones | global map (optional)
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: SLAM | Confirmed global cone landmarks
      Enabled: true
      Topic:
        Value: /map/global_cones_markers
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  - Class: rviz_common/Group
    Name: Perception cones | ZED cylinders (optional)
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Perception | ZED blue/yellow/orange cone cylinders
      Topic:
        Value: /zed/zed_node/cone_markers
        History Policy: Keep Last
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
  - Class: rviz_common/Group
    Name: Classical | proposed path
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/Path
      Name: Classical planning | Proposed path (read-only)
      Enabled: true
      Topic:
        Value: /planning/classical/path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 30; 235; 185
      Line Style: Lines
      Line Width: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Name: Classical planning | Corridor and diagnostics
      Enabled: false
      Topic:
        Value: /planning/classical/markers
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  - Class: rviz_common/Group
    Name: Acceleration | proposed path
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/Path
      Name: Acceleration planning | Proposed path (read-only)
      Enabled: true
      Topic:
        Value: /planning/acceleration/path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 250; 175; 40
      Line Style: Lines
      Line Width: 0.08
    - Class: rviz_default_plugins/MarkerArray
      Name: Acceleration | optional path markers
      Enabled: false
      Topic:
        Value: /planning/acceleration/markers
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  - Class: rviz_common/Group
    Name: Skidpad | proposed path
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/Path
      Name: Skidpad planning | Proposed path (read-only)
      Enabled: true
      Topic:
        Value: /planning/skidpad/path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 208; 125; 255
      Line Style: Lines
      Line Width: 0.08
    - Class: rviz_default_plugins/MarkerArray
      Name: Skidpad | optional path markers
      Enabled: false
      Topic:
        Value: /planning/skidpad/markers
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  - Class: rviz_common/Group
    Name: Deep Learning | proposed path
    Enabled: false
    Displays:
    - Class: rviz_default_plugins/Path
      Name: Deep Learning | RAW LSTM 15-point prediction (simulator Control optional)
      Enabled: true
      Topic:
        Value: /planning/deep_learning/raw_path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 65; 220; 240
      Line Style: Lines
      Line Width: 0.15
    - Class: rviz_default_plugins/Path
      Name: Deep Learning | SAFETY-GATED path (optional)
      Enabled: false
      Topic:
        Value: /planning/deep_learning/path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 245; 110; 150
      Line Style: Lines
      Line Width: 0.1
  - Class: rviz_common/Group
    Name: Track Control | SLAM goal, obstacle-aware path and Stanley
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Path
      Name: SLAM track corridor | cone-aware planned route
      Enabled: true
      Topic:
        Value: /planning/track_goal/path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 160; 70
      Line Style: Lines
      Line Width: 0.16
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: RViz goal | fixed map destination (orange arrow)
      Topic:
        Value: /planning/track_goal/goal_marker
        History Policy: Keep Last
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Stanley | steering lookahead (green dot)
      Topic:
        Value: /control/stanley/target
        History Policy: Keep Last
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Stanley | ACTUAL driven trajectory (blue)
      Enabled: true
      Topic:
        Value: /control/stanley/driven_path
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 65; 160; 255
      Line Style: Lines
      Line Width: 0.16
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Control | speed, steering, ROS/manual and tracking status
      Topic:
        Value: /control/stanley/diagnostic_marker
        History Policy: Keep Last
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
  - Class: rviz_common/Group
    Name: Diagnostics | odometry and TF (optional)
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Odometry
      Name: Vehicle | Existing bridge odometry (optional)
      Enabled: true
      Topic:
        Value: /odom
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: Existing map / odom / base_link TF (optional)
      Enabled: false
  Global Options:
    Background Color: 24; 31; 42
    Fixed Frame: map
    Frame Rate: 12
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 19
      Focal Point:
        X: 0
        Y: 0
        Z: 0.35
      Pitch: 0.78
      Target Frame: base_link
      Yaw: 0.0
      Value: Orbit (rviz)
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
  Value: true
Window Geometry:
  Width: 1200
  Height: 800
