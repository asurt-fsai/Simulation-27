Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 65
    Property Tree Widget:
      Expanded: []
      Tree Height: 460
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: FlatAsphalt map-ground plane (z=0)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 130; 130; 130
      Alpha: 0.25
      Reference Frame: map
      Plane: XY
      Offset:
        X: 0
        Y: 0
        Z: -0.02
    - Class: rviz_default_plugins/RobotModel
      Name: FSAI | map-ground aligned preview
      Enabled: true
      Description Source: File
      Description File: /home/hassan/ASURT/Simulation/Systems/SLAM/Visualization/fsai_vehicle_map_ground_preview.urdf
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
      TF Prefix: ''
    - Class: rviz_default_plugins/MarkerArray
      Name: Mapped cones | original ASURT baseline
      Enabled: true
      Topic:
        Value: /map/global_cones_markers
        History Policy: Keep Last
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Global Options:
    Background Color: 24; 31; 42
    Fixed Frame: map
    Frame Rate: 12
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 19
      Focal Point:
        X: 0
        Y: 0
        Z: 0.35
      Pitch: 0.72
      Target Frame: base_link
      Yaw: 0
      Value: Orbit (rviz)
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
Window Geometry:
  Width: 1200
  Height: 800
